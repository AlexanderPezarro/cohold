# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# For production, use absolute path: file:/absolute/path/to/data/landlord.db
DATABASE_URL=file:./data/landlord.db

# Authentication & Session
# IMPORTANT: Generate a strong random secret for production
# Example: openssl rand -base64 32
SESSION_SECRET=change-this-in-production
JWT_SECRET=change-this-in-production

# Client URL (for CORS in development, and for building links in outgoing emails)
CLIENT_URL=http://localhost:5173

# Initial Admin Account (optional)
# If BOTH are set, an admin user is created automatically on first startup.
# Ignored once setup has completed, so it is safe to leave these in place.
# Leave unset to create the first account through the setup wizard instead.
# OWNER_EMAIL=you@example.com
# ADMIN_PASSWORD=change-this-immediately

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Cohold <noreply@mail.cohold.uk>

# Address lookup (optional)
# Postcode lookup always fills town and county via postcodes.io (free, no key).
# Set an OS Places key (OS Data Hub, premium plan) to also list the addresses at a postcode.
# OS_PLACES_API_KEY=

# Storage
# Directory for uploaded files (relative to project root)
UPLOAD_DIR=uploads

# AES-256 encryption key for uploaded files (32 bytes = 64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_character_hex_string_here

# Bank Integration
# AES-256 encryption key for OAuth tokens (32 bytes = 64 hex characters)
# Generate with: openssl rand -hex 32
BANK_TOKEN_ENCRYPTION_KEY=your_64_character_hex_string_here

# Monzo OAuth Configuration
MONZO_CLIENT_ID=your_monzo_client_id
MONZO_CLIENT_SECRET=your_monzo_client_secret
MONZO_REDIRECT_URI=http://localhost:3000/api/bank/monzo/callback

# Monzo Webhook Configuration
# Base URL for webhook callbacks (defaults to http://localhost:3000 if not set)
# In production, set this to your public domain (e.g., https://yourdomain.com)
WEBHOOK_BASE_URL=http://localhost:3000

# Monzo Webhook Secret (use random UUID for security)
# Generate with: node -e "console.log(require('crypto').randomUUID())"
# The webhook URL registered with Monzo should include this secret:
# https://yourdomain.com/api/bank/webhooks/monzo/{MONZO_WEBHOOK_SECRET}
MONZO_WEBHOOK_SECRET=your-random-uuid-here
