{
  "name": "cohold",
  "version": "1.0.0",
  "description": "Self-hostable property management software for landlords",
  "homepage": "https://github.com/AlexanderPezarro/cohold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderPezarro/cohold.git"
  },
  "bugs": {
    "url": "https://github.com/AlexanderPezarro/cohold/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx server/src/server.ts",
    "dev:client": "cd client && npm run dev",
    "storybook": "cd client && npm run storybook",
    "build": "npm run build:client && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "cd client && npm run build",
    "start": "NODE_ENV=production node dist/server/server/src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=4096\" jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:smoke": "tsx prisma/seed.smoke.ts",
    "db:reset": "prisma migrate reset",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "email:dev": "email dev --dir server/src/email/templates"
  },
  "keywords": [
    "landlord",
    "property-management",
    "self-hosted",
    "prisma",
    "react"
  ],
  "author": "Alexander Pezarro",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.5",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.2.18",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.2.4",
    "prisma": "^7.2.0",
    "react-email": "^6.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@apollo/server": "^4.12.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.0",
    "better-sqlite3-session-store": "^0.1.0",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.0",
    "graphql": "^16.10.0",
    "helmet": "^7.1.0",
    "monzo-core": "github:AlexanderPezarro/monzo-core#v1.0.0",
    "multer": "^2.0.2",
    "qs": "^6.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.6.0",
    "resend": "^6.18.1",
    "zod": "^4.3.5"
  },
  "overrides": {
    "minimatch@9": "^9.0.9",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
